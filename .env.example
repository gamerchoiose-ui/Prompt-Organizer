# Required for AI prompt generation/optimization
GEMINI_API_KEY=

# Optional — override the model used for prompt generation/optimization.
# Defaults to gemini-2.5-flash. Prefer stable model IDs (see
# https://ai.google.dev/gemini-api/docs/models); "preview" and dated
# IDs get shut down and will cause 500s.
GEMINI_MODEL=gemini-2.5-flash

# Set to "production" when serving the built app
NODE_ENV=development
